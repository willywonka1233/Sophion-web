# ─── Servidor ───────────────────────────────────────────────
PORT=3000

# ─── WhatsApp Cloud API (Meta) ──────────────────────────────
# Lo sacas en developers.facebook.com → tu App → WhatsApp → API Setup
WHATSAPP_TOKEN=              # Token permanente del System User
WHATSAPP_PHONE_NUMBER_ID=    # ID del número de teléfono (no el número)
# Lo inventas tú; debe coincidir con el que pongas en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=sophion-club-2026

# ─── Claude (Anthropic) ─────────────────────────────────────
# La sacas en console.anthropic.com
ANTHROPIC_API_KEY=
# Modelo: haiku = más barato/rápido | sonnet = cierra mejor
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ─── Pagos ──────────────────────────────────────────────────
# Proveedor activo: "mercadopago" | "stripe" | "manual"
PAYMENT_PROVIDER=manual

# Mercado Pago (si PAYMENT_PROVIDER=mercadopago)
MERCADOPAGO_ACCESS_TOKEN=

# Stripe (si PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=

# Link fijo de pago (si PAYMENT_PROVIDER=manual): pega aquí tu link de cobro
MANUAL_PAYMENT_LINK=https://tu-link-de-pago.com

# ─── Negocio ────────────────────────────────────────────────
# Precio por defecto de la membresía en centavos (ej: 49900 = $499.00)
PRECIO_MEMBRESIA=49900
MONEDA=MXN
